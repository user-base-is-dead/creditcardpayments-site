# Copy this file to `.env` — on the VPS too. Without a `.env` the server falls
# back to dev defaults (admin/admin123, weak JWT secret, CORS = localhost).
#   cp .env.example .env
#
# This repo is PUBLIC, so the three secrets below stay placeholders.
# Fill them in only in `.env`, which is gitignored.

PORT=4000
# Uncomment on the VPS so the API is only reachable through nginx, never on
# http://<VPS_IP>:4000 directly. Check nginx points at 127.0.0.1:4000 first.
# HOST=127.0.0.1

NODE_ENV=production
# NODE_ENV=development

# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=https://creditcardpayment.in,https://www.creditcardpayment.in

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10


# Admin panel credentials — approves/rejects money transfers, reads all users.
ADMIN_USERNAME=
ADMIN_PASSWORD=
