# ─────────────────────────────────────────────────────────────
# Backend environment template.
#
#   cp .env.example .env      # then fill in REAL values
#
# `.env` is gitignored — this template is committed, so it must never
# contain a real password, token or signing key.
#
# The server reads this file at boot (src/config/env.js). If the file is
# missing, every value below falls back to an INSECURE development default,
# so a VPS without a `.env` ends up with a public admin panel.
# ─────────────────────────────────────────────────────────────

# Port the Express API + Socket.io server listens on.
# nginx should proxy /api and /socket.io to 127.0.0.1:<PORT>.
PORT=4000

# Interface to bind to. Leave this line commented out to keep Node's default
# (listen on every interface) — that is what the server does today.
#
# Uncomment it when nginx runs on the same machine as the API. The backend has
# no domain of its own, so it only ever needs to be reachable from localhost;
# binding to loopback stops anyone from hitting http://<VPS_IP>:4000 directly
# and bypassing Cloudflare + nginx. Verify nginx points at 127.0.0.1:4000
# (not the LAN/public IP, and not a container network) before enabling it.
# HOST=127.0.0.1

# development | production
# MUST be `production` on the VPS. It enables the fail-fast startup checks for
# JWT_SECRET / ADMIN_PASSWORD and turns off verbose request logging.
NODE_ENV=production

# Comma-separated list of browser origins allowed to call the API.
# Include the scheme, no trailing slash, and list every hostname the site is
# reachable on (apex + www). Browsers send an `Origin` header on same-origin
# POSTs as well, so a wrong value here breaks login / contact / transfers.
#   local dev  -> http://localhost:5173
#   production -> https://creditcardpayment.in,https://www.creditcardpayment.in
CORS_ORIGIN=https://creditcardpayment.in,https://www.creditcardpayment.in

# Signing key for user auth tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every existing login.
JWT_SECRET=generate-a-96-char-random-hex-string-do-not-use-this-value

# How long an issued login stays valid (e.g. 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# bcrypt cost factor for stored passwords. 10 is the floor, 12 is recommended.
BCRYPT_ROUNDS=12

# ─── Admin panel credentials (/admin) ───
# These are the ONLY guard on the admin panel: it can approve, reject and
# complete money transfers and read every user record. Use a unique, long,
# randomly generated password and set it only in the server's `.env`.
ADMIN_USERNAME=set-a-non-obvious-username
ADMIN_PASSWORD=set-a-long-random-password
