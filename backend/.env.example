# Production config. CI may copy this over `.env` on every deploy:
#   cp .env.example .env
#
# This repo is PUBLIC, so secrets cannot live here. Put them in `.env.local`
# instead — it is gitignored, it takes priority over `.env`, and CI never
# touches it, so a deploy can't wipe it. Create it once on the server:
#
#   cd backend
#   cat > .env.local <<'EOF'
#   JWT_SECRET=<node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
#   ADMIN_USERNAME=<pick something non-obvious>
#   ADMIN_PASSWORD=<long random password>
#   EOF
#
# Without .env.local the server refuses to start instead of falling back to
# insecure defaults (admin/admin123, weak JWT secret).

PORT=4000
# Uncomment on the VPS so the API is only reachable through nginx, never on
# http://<VPS_IP>:4000 directly. Check nginx points at 127.0.0.1:4000 first.
# HOST=127.0.0.1

NODE_ENV=production
# NODE_ENV=development

# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=https://creditcardpayment.in,https://www.creditcardpayment.in

JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── Set these in .env.local, not here ───
# JWT_SECRET=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
