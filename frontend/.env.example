# ─────────────────────────────────────────────────────────────
# Frontend environment template.
#
#   cp .env.example .env
#
# VITE_* values are inlined into the JavaScript bundle at build time and are
# therefore PUBLIC. Never put a password, token or signing key in this file.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API + Socket.io server.
#
# Leave BLANK (recommended). The app then uses same-origin relative URLs
# (`/api/...`, `/socket.io`), which nginx — or the Vite dev/preview proxy —
# forwards to the Node backend. Same-origin also avoids CORS entirely.
#
# Only set this when the API is served from a different hostname, e.g.
#   VITE_API_URL=https://api.creditcardpayment.in
# and make sure that host is listed in the backend's CORS_ORIGIN.
VITE_API_URL=

# ─── Build/serve-time only (read by vite.config.js, NOT sent to the browser) ───

# Where the dev/preview proxy forwards /api and /socket.io.
# The backend has no public domain — it is reached only from this machine — so
# this stays a loopback address. Must match the backend's PORT.
BACKEND_ORIGIN=http://localhost:4000

# `vite preview` bind address/port. Leave commented out to use Vite's defaults
# (localhost:4173). Only set these if nginx's upstream points somewhere else.
# PREVIEW_HOST=127.0.0.1
# PREVIEW_PORT=4173

# ONLY for the (discouraged) setup where `vite dev` is exposed through
# nginx/Cloudflare instead of serving a production build. Tells Vite's HMR
# client to reach the websocket over the public TLS port instead of
# 127.0.0.1:<port> — without it the client reload-loops the page forever.
# Leave both commented out for local development and for `vite preview`.
# HMR_CLIENT_PORT=443
# HMR_PROTOCOL=wss
