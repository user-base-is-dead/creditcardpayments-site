# Copy this file to `.env`.
#   cp .env.example .env

# Blank = same-origin (/api, /socket.io). nginx / the Vite proxy forwards those
# to the backend, so no CORS and no separate API domain. Only set this if the
# API ever moves to its own host.
VITE_API_URL=

# Read by vite.config.js only — never sent to the browser.

# Where the dev/preview proxy forwards /api and /socket.io.
BACKEND_ORIGIN=http://localhost:4000

# `vite preview` bind. Defaults to localhost:4173 when left commented.
# PREVIEW_HOST=127.0.0.1
# PREVIEW_PORT=4173

# Only if `vite dev` is exposed through nginx instead of serving a build.
# Stops Vite's HMR client from reload-looping the page every visitor.
# HMR_CLIENT_PORT=443
# HMR_PROTOCOL=wss
